@article{Karnawat:2006,
	Abstract = {Cette article pr{\'e}sente les r{\'e}sultats de l'{\'e}tude exp{\'e}rimentale d'un
	injecteur diphasique associant atomisation par swirl et atomisation
	par effervescence. Les injecteurs {\`a} swirl appartiennent {\`a} la famille
	des atomiseurs par diff{\'e}rentiel de pression. Une vrille conf{\`e}re {\`a}
	l'{\'e}coulement liquide une forte vitesse angulaire ce qui cr{\'e}e une
	zone de d{\'e}pression au centre du spray {\`a} la sortie de l'{\'e}coulement.
	Le spray obtenue a la forme d'un cone creux. Les atomiseurs effervescents
	sont des syst{\`e}mes assist{\'e}s par air. Dans ce cas l'air est directement
	inject{\'e} dans l'{\'e}coulement liquide en amont de la sortie. Le spray
	obtenu est peu {\'e}vas{\'e} et solide. L'association des deux techniques
	permet de cont{\^o}ler de nombreux param{\`e}tres du spray ({\'e}largissement,
	longueur de rupture, taille de goutte, spray creux ou solide...).
	En variant le d{\'e}bit d'air inject{\'e} on peut en effet donn{\'e} de mani{\`e}re
	plus ou moins marqu{\'e} les caract{\'e}ristiques d'un spray issu de l'une
	ou l'autre technologie. Ce syst{\`e}me permet de plus de r{\'e}duire la pression
	d'admission du luiquide et donc l'{\'e}nergie d'atomisation.},
	Author = {Karnawat, J. and Kushari, A.},
	Date-Added = {2008-05-21 18:26:26 +0200},
	Date-Modified = {2008-06-25 15:13:24 +0200},
	File = {D\:\\guezenne\\Articles\\Atomisation\\Kushari2006.pdf:D\:\\guezenne\\Articles\\Atomisation\\Kushari2006.pdf:PDF},
	Journal = {Experiments in Fluids},
	Owner = {guezenne},

@article{Pavlova:2007,
	Abstract = {Les auteurs pr{\'e}sentent l'effet d'un jet synth{\'e}tique impactant un spray
	produit par un atomiseur assist{\'e} par air Delavan. Le jet synth{\'e}tique
	est form{\'e} d'un train de tourbillon toriques cr{\'e}{\'e}s p{\'e}riodiquement
	par une cavit{\'e} mise en r{\'e}sonance avec des disque pi{\'e}zo{\'e}lectriques.
	Ce n'est pas un {\'e}coulement au sens propre du terme car le d{\'e}bit total
	par cycle est nul. Mais ce dispositif permet toutefois un transfert
	de quantit{\'e} de mouvement vers l'{\'e}coulement actionn{\'e}. Les auteurs
	montrent ainsi qu'il est possible de d{\'e}vier le spray de son axe jusqu'{\`a}
	18$\,^{\circ}$. Cette d{\'e}viation diminue toutefois lorsque le rapport de d{\'e}bit
	entre l'{\'e}coulement de gaz et de liquide (Qair/Qliq) augmente. Le
	syst{\`e}me permet aussi de modifier la r{\'e}partition des gouttes dans
	le spray. Les plus petites gouttes sont transf{\'e}rer {\`a} traver le spray
	vers le cot{\'e} oppos{\'e} {\`a} la zone d'actionnement.},
